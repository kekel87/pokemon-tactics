# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Vite
.vite/

# Test coverage
coverage/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Logs
*.log

# Claude Code local settings
.claude/settings.local.json
.claude/*.lock

# Worktrees parallèles (sessions Claude //) + port Vite par worktree
.worktrees/
.worktree-port

# Reference data build cache (regeneratable)
packages/data/.cache/

# Sprite sources (plans 135, 168, 237): per-Pokemon folders emitted by `pnpm extract-sprites`
# (PMDCollab) and per-item icons emitted by `pnpm extract-item-icons` (Pokemon Showdown), both
# regeneratable. They live outside `public/` so Vite never copies them into a build; only the
# packed bundle under `packages/app/public/assets/sprites/` ships and is committed.
assets-src/sprites/
# Former locations (before plan 237), still ignored so an older clone or worktree that has them
# never commits them; the build refuses to ship them (`vite.config.ts`).
packages/app/public/assets/sprites/pokemon/
packages/app/public/assets/sprites/item-icons/

# Reference screenshots (local only)
docs/references/

# Tiles workspace (tests, temporaires)
tiles/

# Promo / diffusion notes (local only — stratégie privée, repo public)
docs/promo-channels.md

# Shared screenshots (échanges humain/Claude)
share/

# Visual tester screenshots (generated by visual-tester agent)
screenshots/
.screenshots/
# Sorties de la séquence d'intro (plan 194) : vidéo + artefacts Playwright
.captures/

.playwright-mcp/
# Playwright e2e artefacts (plan 127)
test-results/
playwright-report/
blob-report/
.last-run.json
wiki/
.mcp.json

# Tiled editor user state (per-workstation, not shared)
*.tiled-session

# Serena MCP (cache et config locale, project.yml est versionné)
.serena/cache/
.serena/project.local.yml

# Understand Anything (fichiers intermédiaires — knowledge-graph.json est versionné)
.understand-anything/intermediate/
.understand-anything/tmp/

# Claude Code state files (local only)
.itch-feedback-last-run
.claude/scheduled_tasks.lock

# Scripts de probe e2e jetables (jamais commités)
_*.mjs

# Exports voxel intermédiaires (Goxel → .gltf) : régénérables, artefact runtime = .glb (public/),
# sources = .gox (assets-src/voxel/goxel/). On ne commite pas l'étape .gltf.
assets-src/voxel/*.gltf

# Cloudflare Worker de télémétrie (plan 196) : état local de wrangler + secrets de dev.
# `.dev.vars` porte le secret du haché de visiteur en local (décision #879) — jamais commité.
# Les identifiants non secrets (account_id, database_id) restent, eux, dans wrangler.toml versionné.
.wrangler/
.dev.vars
.dev.vars.*

# État runtime des hooks (marqueurs de session, dédup mémoire) — jamais versionné
.claude/.state/

# Rapports générés par les scripts d'analyse — jamais versionnés
.reports/

# Bytecode Python des hooks
__pycache__/
*.pyc
# Move-effect particle source folder (plan 234): PNGs downloaded from PMDCollab/RawAsset (PMD
# Origins), regeneratable via `pnpm build-move-effects`. Only the packed sheet
# (packages/app/public/assets/effects/move-effects.png) and its generated index ship.
assets-src/effects/
